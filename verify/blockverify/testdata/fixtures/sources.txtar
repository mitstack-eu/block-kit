-- resources-kit-observed-block_test.go --
package main

import (
	"context"
	"encoding/json"
	"os"
	"sync"
	"testing"

	"github.com/mitstack-eu/block-kit/contract"
	"github.com/mitstack-eu/block-kit/handler"
	"github.com/mitstack-eu/block-kit/observe"
	"github.com/mitstack-eu/block-kit/verify/kittest"
)

const registryHost = "123456789012.dkr.ecr.eu-central-1.amazonaws.com"

type awsObject struct{ typ, sub string }

// awsProvider stands in for AWS, holding each bucket and repository by name and counting every read the block's code makes.
type awsProvider struct {
	mu      sync.Mutex
	objects map[string]awsObject
	reads   int
}

func (p *awsProvider) object(name string) (awsObject, bool) {
	p.mu.Lock()
	defer p.mu.Unlock()
	p.reads++
	o, ok := p.objects[name]
	return o, ok
}

func (p *awsProvider) Reads() int {
	p.mu.Lock()
	defer p.mu.Unlock()
	return p.reads
}

func (p *awsProvider) Exists(_ context.Context, _ contract.Desired, _, name string) (bool, error) {
	_, ok := p.object(name)
	return ok, nil
}

func (p *awsProvider) Tags(_ context.Context, _ contract.Desired, _, name string) (map[string]string, bool, error) {
	o, ok := p.object(name)
	return map[string]string{observe.AWSSubscriptionTag: o.sub}, ok, nil
}

func (p *awsProvider) GetResource(_ context.Context, _ contract.Desired, _, name string) ([]byte, bool, error) {
	o, ok := p.object(name)
	if !ok {
		return nil, false, nil
	}
	doc := map[string]any{"Tags": []map[string]string{{"Key": observe.AWSSubscriptionTag, "Value": o.sub}}}
	if o.typ == "aws.ecr-repository" {
		doc["RepositoryUri"] = registryHost + "/" + name
	}
	raw, err := json.Marshal(doc)
	return raw, true, err
}

func (p *awsProvider) BucketExists(ctx context.Context, d contract.Desired, name string) (bool, error) {
	return p.Exists(ctx, d, "AWS::S3::Bucket", name)
}

func (p *awsProvider) ResourceARNs(_ context.Context, _ contract.Desired, _, value string) ([]string, error) {
	tagged, _ := p.ListTagged(context.Background(), value)
	arns := make([]string, 0, len(tagged))
	for _, t := range tagged {
		if t.Type == "aws.ecr-repository" {
			arns = append(arns, "arn:aws:ecr:eu-central-1:123456789012:repository/"+t.ID)
		} else {
			arns = append(arns, "arn:aws:s3:::"+t.ID)
		}
	}
	return arns, nil
}

func (p *awsProvider) ListTagged(_ context.Context, sub string) ([]observe.Tagged, error) {
	p.mu.Lock()
	defer p.mu.Unlock()
	p.reads++
	var out []observe.Tagged
	for name, o := range p.objects {
		if o.sub == sub {
			out = append(out, observe.Tagged{Type: o.typ, ID: name})
		}
	}
	return out, nil
}

func (p *awsProvider) put(name, typ, sub string) {
	p.mu.Lock()
	defer p.mu.Unlock()
	p.objects[name] = awsObject{typ: typ, sub: sub}
}

func (p *awsProvider) remove(name string) {
	p.mu.Lock()
	defer p.mu.Unlock()
	delete(p.objects, name)
}

func (p *awsProvider) Lose(_ context.Context, r contract.CreatedResource) error {
	for _, name := range r.Identity {
		p.remove(name)
	}
	return nil
}

type kitObservedBlock struct{ p *awsProvider }

func (b kitObservedBlock) EnsureResources(_ context.Context, d contract.Desired) ([]contract.CreatedResource, error) {
	bucket, repository := "bucket-"+d.SubscriptionID, "images-"+d.SubscriptionID
	b.p.put(bucket, "aws.s3-bucket", d.SubscriptionID)
	b.p.put(repository, "aws.ecr-repository", d.SubscriptionID)
	return []contract.CreatedResource{
		{Name: "aws.s3-bucket", Type: "aws.s3-bucket", Identity: map[string]string{"bucket": bucket}},
		{Name: "aws.ecr-repository", Type: "aws.ecr-repository", Identity: map[string]string{"repositoryName": repository}},
	}, nil
}

func (b kitObservedBlock) Ensure(ctx context.Context, d contract.Desired) error {
	_, err := b.EnsureResources(ctx, d)
	return err
}

func (b kitObservedBlock) Delete(_ context.Context, d contract.Desired) (map[string]string, error) {
	b.p.remove("bucket-" + d.SubscriptionID)
	b.p.remove("images-" + d.SubscriptionID)
	return nil, nil
}

func assertKitObservedBlock(t *testing.T, ownObserver bool) {
	manifest, err := os.ReadFile("manifest.yaml")
	if err != nil {
		t.Fatal(err)
	}
	raw, err := os.ReadFile("type-snapshot.json")
	if err != nil {
		t.Fatal(err)
	}
	snap, err := contract.ParseTypeSnapshot(raw)
	if err != nil {
		t.Fatal(err)
	}
	p := &awsProvider{objects: map[string]awsObject{}}
	in := kittest.Block{
		Config:   handler.Config{Resource: kitObservedBlock{p: p}, Manifest: manifest, Types: snap, KitObserver: observe.KitObserver{AWS: p}},
		Provider: p,
		Desired:  contract.Desired{Identity: contract.Identity{SubscriptionID: "sub-fixture", BlockID: "blockverify-fixture", OrgID: "org-fixture"}},
	}
	upgrade := in.Desired
	upgrade.Params = map[string]string{"versioning": "on"}
	in.Upgrade = &upgrade
	if ownObserver {
		in.Config.Observers = map[string]handler.Observer{"aws.s3-bucket": observe.S3Bucket{API: p}}
	}
	kittest.AssertBlock(t, in)
}
