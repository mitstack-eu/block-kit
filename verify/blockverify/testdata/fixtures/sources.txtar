package main

import "net/url"

func allowedGitHubHosts() []string { return []string{"api.github.com"} }

func trustedGitHubBase(c githubCreds) (string, error) {
	u, err := url.Parse(c.Secrets["github"]["endpoint"])
	if err != nil {
		return "", err
	}
	return "https://" + u.Host, nil
}
