  id: blockverify-block-fixture
  name: blockverify block fixture
  owner: blockverify-tests
spec:
  version: 1.0.0
  description: A fixture block that creates an instance and its data volume.
  resources:
    - aws.ec2-instance
    - aws.ebs-volume
  provides: [aws.ec2-instance]
