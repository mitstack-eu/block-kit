   "category": "storage", "outputs": [], "version": 1,
   "observeSpec": {"find": {"tag": "mitstack:subscription", "identity": "bucket"}, "probe": {"reads": ["tags", "existence"], "maxReads": 4},
     "fullRead": {"cloudControl": "AWS::S3::Bucket"}}},
  {"id": "aws.ecr-repository", "capability": "aws", "kind": "container-repository", "scope": "per-app", "stateful": false, "pricing": {"priced": false},
