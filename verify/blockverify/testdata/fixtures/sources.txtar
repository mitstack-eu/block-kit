    A fixture block whose bucket and image repository the kit observer reads,
    used only to prove blockverify's own conformance suite.
  resources: [aws.s3-bucket, aws.ecr-repository]
  provides: [aws.ecr-repository]
  lifecycle:
    endpoint: https://api.mitstack.dev/operators/blockverify-fixture/hook
