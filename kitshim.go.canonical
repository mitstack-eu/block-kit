package main

// kitshim.go — MIT-1466.
//
// The mitstack trust boundary (Ed25519 webhook signature, replay/skew window,
// OBO audience binding, the /logs signed GET, the recent-log ring buffer) and
// the ADR 0042 events channel now have exactly ONE implementation, in the
// operator-kit module. This file is the operator's thin binding to it.
//
// It exists so that migrating to the kit changed no operator's behaviour and no
// operator's tests: every identifier below keeps the name and signature the
// hand-copied auth.go/ed25519verify.go/obo.go/logs.go/events.go exported, and
// the package-level Replay/KeyCache/LogBuffer values reproduce the
// process-scoped semantics those files had via package globals.
//
// KEEP THIS FILE IDENTICAL ACROSS OPERATORS — scripts/check-operator-kit-pin.sh
// enforces that, and that an operator declares no local replacement for a
// kit-owned symbol. Do not add operator-specific code here; put it in the
// operator's own files.

import (
	"context"
	"crypto/ed25519"
	"net/http"
	"time"

	"github.com/mitstack-eu/operator-kit/events"
	"github.com/mitstack-eu/operator-kit/webhook"
)

// Process-scoped state, matching what the copied files kept in package globals:
// one nonce guard, one JWKS key cache and one log ring buffer per operator
// process.
// jwksCache memoises fetched keys by kid; nonceCache records recently-seen
// nonces. They stay package variables of these exact types because that is the
// contract the operator's tests already rely on: every one of them isolates
// itself by REASSIGNING the variable (`jwksCache = map[string]ed25519.PublicKey{}`).
// The kit is handed their addresses, not their values, so such a reset really
// does clear the cache — a by-value hand-off would have made those resets
// silently ineffective and leaked state between tests.
var (
	jwksCache  = map[string]ed25519.PublicKey{}
	nonceCache = map[string]time.Time{}
)

var (
	kitReplay    = webhook.NewReplayOver(&nonceCache)
	kitKeys      = webhook.NewKeyCacheOver(&jwksCache)
	kitLogBuffer = webhook.NewLogBuffer(maxRecentLogLines)
)

const maxRecentLogLines = webhook.MaxRecentLogLines

// replaySkew bounds how far a signed request's createdAt may differ from this
// verifier's clock (T-357).
const replaySkew = webhook.ReplaySkew

// kitDeps binds the kit's authenticators to THIS operator's key resolution and
// error writer, so response bodies stay exactly as they were.
func kitDeps(h *Handler) webhook.Deps {
	return webhook.Deps{
		JWKSURL:    h.JWKSURL,
		PublicKey:  h.publicKey,
		Replay:     kitReplay,
		WriteError: writeError,
	}
}

// authenticate verifies mitstack's zero-touch Ed25519 signature on the webhook
// body against the platform public key fetched from the global JWKS by key id.
func authenticate(h *Handler, w http.ResponseWriter, r *http.Request, body []byte) (ed25519.PublicKey, bool) {
	return webhook.AuthenticateHook(kitDeps(h), w, r, body)
}

// authenticateLogsGET verifies mitstack's Ed25519 signature for a read-only GET
// that carries no request body (T-578).
func authenticateLogsGET(h *Handler, w http.ResponseWriter, r *http.Request) (ed25519.PublicKey, bool) {
	return webhook.AuthenticateLogsGET(kitDeps(h), w, r)
}

// verifyReplay rejects a webhook whose signed createdAt is outside the skew
// window or whose nonce was already seen.
func verifyReplay(body []byte, now time.Time) error { return kitReplay.Verify(body, now) }

// verifyTimestampSkew bounds a read-only GET's signed X-Mitstack-Timestamp.
func verifyTimestampSkew(ts string, now time.Time) error {
	return webhook.VerifyTimestampSkew(ts, now)
}

// verifyEd25519Sig strips the "ed25519=" prefix, base64-decodes, and verifies.
func verifyEd25519Sig(pub ed25519.PublicKey, body []byte, sigHeader string) bool {
	return webhook.VerifyEd25519Sig(pub, body, sigHeader)
}

// publicKeyFromJWKS extracts the Ed25519 (OKP) key for kid from a JWKS document.
func publicKeyFromJWKS(jwksJSON []byte, kid string) (ed25519.PublicKey, error) {
	return webhook.PublicKeyFromJWKS(jwksJSON, kid)
}

// publicKey returns the Ed25519 public key for kid, fetched once and memoised.
func (h *Handler) publicKey(kid string) (ed25519.PublicKey, error) {
	return kitKeys.PublicKey(h.JWKSURL, h.Client, kid)
}

// verifyEd25519 resolves the public key for kid and checks the detached
// "ed25519=<base64>" signature over the raw body.
func (h *Handler) verifyEd25519(kid, sigHeader string, body []byte) bool {
	pub, err := h.publicKey(kid)
	if err != nil {
		return false
	}
	return webhook.VerifyEd25519Sig(pub, body, sigHeader)
}

// --- OBO (on-behalf-of) identity token -------------------------------------

// OBOClaims are the identity claims carried inside an on-behalf-of token.
type OBOClaims = webhook.OBOClaims

// ErrOBOExpired is returned by VerifyOBO when the token's expiry has passed.
var ErrOBOExpired = webhook.ErrOBOExpired

// ErrOBOInvalid is returned by VerifyOBO when the token is malformed, has a bad
// signature, or was signed with the wrong key.
var ErrOBOInvalid = webhook.ErrOBOInvalid

// MintOBO mirrors mitstack's Ed25519 token format (for tests that simulate
// mitstack; the operator itself only verifies).
func MintOBO(priv ed25519.PrivateKey, kid string, claims OBOClaims, ttl time.Duration, now time.Time) (string, error) {
	return webhook.MintOBO(priv, kid, claims, ttl, now)
}

// VerifyOBO verifies an Ed25519-signed OBO token against the platform public
// key, enforcing per-operator audience binding when MITSTACK_OBO_AUDIENCE is
// set (T-358).
func VerifyOBO(pub ed25519.PublicKey, token string, now time.Time) (OBOClaims, error) {
	return webhook.VerifyOBO(pub, token, now)
}

// --- recent-log ring buffer + /logs ----------------------------------------

// appendRecentLog adds one line to the recent-log ring buffer.
func appendRecentLog(line string) { kitLogBuffer.Append(line) }

// clearRecentLogs resets the ring buffer (used by tests).
func clearRecentLogs() { kitLogBuffer.Clear() }

// recentLogSnapshot returns a copy of the recent lines, oldest first.
func recentLogSnapshot() []string { return kitLogBuffer.Snapshot() }

// recentLogWriter tees the standard logger's output into the ring buffer, one
// entry per newline-delimited line. Every line the operator emits is already
// secret-scrubbed before it is written, so /logs never holds a plaintext secret.
type recentLogWriter struct{}

func (recentLogWriter) Write(p []byte) (int, error) { return kitLogBuffer.Writer().Write(p) }

// ServeLogs returns the operator's recent (already-scrubbed) log lines as
// {"lines": []}, authenticated by the signed GET path (T-578).
func (h *Handler) ServeLogs(w http.ResponseWriter, r *http.Request) {
	webhook.ServeLogs(kitDeps(h), kitLogBuffer, w, r)
}

// --- ADR 0042 advisory events ----------------------------------------------

// EventsCallback carries the ingest URL + bearer token mitstack injects into the
// signed webhook envelope so the operator can push lifecycle events back.
type EventsCallback = events.Callback

// ContextWithEventsEnvelope stashes the events envelope from the decoded request
// onto ctx, so handler code can emit without threading the request through.
func ContextWithEventsEnvelope(ctx context.Context, req request) context.Context {
	return events.WithEnvelope(ctx, events.Envelope{
		SubscriptionID: req.SubscriptionID,
		Operation:      req.Operation,
		IdempotencyKey: req.IdempotencyKey,
		Callback:       req.EventsCallback,
	})
}

// EmitProgress reports a "progress" event with the given detail.
func EmitProgress(ctx context.Context, detail string) error { return events.EmitProgress(ctx, detail) }

// EmitCompleted reports a "completed" event with no detail.
func EmitCompleted(ctx context.Context) error { return events.EmitCompleted(ctx) }

// EmitFailed reports a "failed" event carrying the given failure detail.
func EmitFailed(ctx context.Context, detail string) error { return events.EmitFailed(ctx, detail) }

// scrubEventDetail redacts secret-shaped assignments from an event detail before
// it is sent off-process.
func scrubEventDetail(detail string) string { return events.ScrubDetail(detail) }
