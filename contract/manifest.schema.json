{
  "$defs": {
    "typeId": {
      "description": "A resource type id: a community type <capability>.<name>, or an org's private type @<org>/<capability>.<name>, in lowercase kebab case.",
      "pattern": "^(@[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?/)?[a-z]([a-z0-9-]{0,38}[a-z0-9])?\\.[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "type": "string"
    },
    "typeIds": {
      "description": "One type id, or a list of the type ids the entry may be met or created by.",
      "oneOf": [
        {
          "$ref": "#/$defs/typeId"
        },
        {
          "items": {
            "$ref": "#/$defs/typeId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      ]
    }
  },
  "$id": "https://mitstack.dev/schemas/block/manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A block manifest under mitstack/v1beta: its requirements by exact type, the resources it creates by exact type, the resources it provides, its lifecycle and its observability. Generated from the operator kit's contract.BlockManifest types; ParseManifest also refuses a resource name used twice or holding a slash, a requirement reference used twice, an entry listing several types without a name, and a provides entry that names no resource or one marked many.",
  "properties": {
    "apiVersion": {
      "const": "mitstack/v1beta",
      "minLength": 1,
      "type": "string"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "owner": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "connection": {
          "additionalProperties": false,
          "properties": {
            "audience": {
              "type": "string"
            },
            "driver": {
              "type": "string"
            },
            "heldOnlyByGrant": {
              "type": "boolean"
            },
            "installHint": {
              "type": "string"
            },
            "mechanism": {
              "minLength": 1,
              "type": "string"
            },
            "objectStorage": {
              "additionalProperties": false,
              "properties": {
                "accessKeyField": {
                  "minLength": 1,
                  "type": "string"
                },
                "endpointTemplate": {
                  "minLength": 1,
                  "type": "string"
                },
                "secretKeyField": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "accessKeyField",
                "secretKeyField",
                "endpointTemplate"
              ],
              "type": "object"
            },
            "tokenSchema": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "allowedValues": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "description": {
                    "type": "string"
                  },
                  "name": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "optionalGroup": {
                    "type": "string"
                  },
                  "secret": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "secret"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "mechanism"
          ],
          "type": "object"
        },
        "description": {
          "type": "string"
        },
        "docs": {
          "additionalProperties": false,
          "properties": {
            "index": {
              "type": "string"
            },
            "links": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "rel": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "url": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "rel",
                  "url"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "pages": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "anchors": {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "type": "object"
                  },
                  "path": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "title": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "title",
                  "path"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "source": {
              "additionalProperties": false,
              "properties": {
                "git": {
                  "minLength": 1,
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "ref": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "git",
                "ref"
              ],
              "type": "object"
            }
          },
          "type": "object"
        },
        "kinds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "lifecycle": {
          "additionalProperties": false,
          "properties": {
            "contract": {
              "minLength": 1,
              "type": "string"
            },
            "endpoint": {
              "minLength": 1,
              "type": "string"
            },
            "needsCredentialRefresh": {
              "type": "boolean"
            },
            "operations": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "settleBudget": {
              "description": "A positive Go duration, such as 75m.",
              "type": "string"
            },
            "verbConnections": {
              "additionalProperties": false,
              "properties": {
                "unsubscribe": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "validate": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            }
          },
          "required": [
            "endpoint",
            "operations",
            "contract"
          ],
          "type": "object"
        },
        "observability": {
          "additionalProperties": false,
          "properties": {
            "cost": {
              "additionalProperties": false,
              "properties": {
                "groupBy": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            "metrics": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "dimensions": {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "type": "object"
                  },
                  "namespace": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "region": {
                    "type": "string"
                  },
                  "resource": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "series": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "metric": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "name": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "stat": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "unit": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "name",
                        "metric",
                        "stat"
                      ],
                      "type": "object"
                    },
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "required": [
                  "resource",
                  "namespace",
                  "series"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "presentation": {
          "additionalProperties": false,
          "properties": {
            "category": {
              "minLength": 1,
              "type": "string"
            },
            "mark": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "circle": {
                    "additionalProperties": false,
                    "properties": {
                      "cx": {
                        "type": "number"
                      },
                      "cy": {
                        "type": "number"
                      },
                      "r": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "cx",
                      "cy",
                      "r"
                    ],
                    "type": "object"
                  },
                  "ellipse": {
                    "additionalProperties": false,
                    "properties": {
                      "cx": {
                        "type": "number"
                      },
                      "cy": {
                        "type": "number"
                      },
                      "rx": {
                        "type": "number"
                      },
                      "ry": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "cx",
                      "cy",
                      "rx",
                      "ry"
                    ],
                    "type": "object"
                  },
                  "line": {
                    "additionalProperties": false,
                    "properties": {
                      "x1": {
                        "type": "number"
                      },
                      "x2": {
                        "type": "number"
                      },
                      "y1": {
                        "type": "number"
                      },
                      "y2": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "x1",
                      "y1",
                      "x2",
                      "y2"
                    ],
                    "type": "object"
                  },
                  "path": {
                    "additionalProperties": false,
                    "properties": {
                      "d": {
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": [
                      "d"
                    ],
                    "type": "object"
                  },
                  "polygon": {
                    "additionalProperties": false,
                    "properties": {
                      "points": {
                        "items": {
                          "type": "number"
                        },
                        "minItems": 1,
                        "type": "array"
                      }
                    },
                    "required": [
                      "points"
                    ],
                    "type": "object"
                  },
                  "polyline": {
                    "additionalProperties": false,
                    "properties": {
                      "points": {
                        "items": {
                          "type": "number"
                        },
                        "minItems": 1,
                        "type": "array"
                      }
                    },
                    "required": [
                      "points"
                    ],
                    "type": "object"
                  },
                  "rect": {
                    "additionalProperties": false,
                    "properties": {
                      "height": {
                        "type": "number"
                      },
                      "rx": {
                        "type": "number"
                      },
                      "ry": {
                        "type": "number"
                      },
                      "width": {
                        "type": "number"
                      },
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "y",
                      "width",
                      "height"
                    ],
                    "type": "object"
                  }
                },
                "type": "object"
              },
              "type": "array"
            },
            "vendor": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "vendor",
            "category"
          ],
          "type": "object"
        },
        "provides": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reach": {
          "additionalProperties": false,
          "properties": {
            "capability": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "capability"
          ],
          "type": "object"
        },
        "receivesAppSecrets": {
          "type": "boolean"
        },
        "releaseClass": {
          "type": "string"
        },
        "releaseNote": {
          "type": "string"
        },
        "requires": {
          "items": {
            "description": "A requirement: a type id, or an object of its type, its name and many.",
            "oneOf": [
              {
                "$ref": "#/$defs/typeId"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "many": {
                    "type": "boolean"
                  },
                  "name": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "type": {
                    "$ref": "#/$defs/typeIds"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "type": "array"
        },
        "resources": {
          "items": {
            "description": "A resource the block creates: a type id, or an object of its type, its name and many.",
            "oneOf": [
              {
                "$ref": "#/$defs/typeId"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "many": {
                    "type": "boolean"
                  },
                  "name": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "type": {
                    "$ref": "#/$defs/typeIds"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "type": "array"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "version",
        "lifecycle"
      ],
      "type": "object"
    },
    "type": {
      "enum": [
        "block",
        "capability"
      ],
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "apiVersion",
    "type",
    "metadata",
    "spec"
  ],
  "title": "mitstack block manifest mitstack/v1beta",
  "type": "object"
}
