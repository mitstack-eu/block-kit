{
  "$defs": {
    "typeId": {
      "description": "A resource type id, <capability>.<name> in lowercase kebab case.",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*\\.[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "type": "string"
    },
    "typeIds": {
      "description": "One type id, or a list of the type ids the entry may be met or created by.",
      "oneOf": [
        {
          "$ref": "#/$defs/typeId"
        },
        {
          "items": {
            "$ref": "#/$defs/typeId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      ]
    }
  },
  "$id": "https://mitstack.dev/schemas/block/manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A block manifest under mitstack/v1beta: its requirements by exact type, the resources it creates by exact type, the resources it provides, its lifecycle and its observability. Generated from the operator kit's contract.BlockManifest types; ParseManifest also refuses a resource name used twice, a requirement reference used twice, an entry listing several types without a name, and a provides entry that names no resource.",
  "properties": {
    "apiVersion": {
      "const": "mitstack/v1beta",
      "minLength": 1,
      "type": "string"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "owner": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "lifecycle": {
          "additionalProperties": false,
          "properties": {
            "contract": {
              "minLength": 1,
              "type": "string"
            },
            "endpoint": {
              "minLength": 1,
              "type": "string"
            },
            "needsCredentialRefresh": {
              "type": "boolean"
            },
            "operations": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "settleBudget": {
              "description": "A positive Go duration, such as 75m.",
              "type": "string"
            },
            "verbConnections": {
              "additionalProperties": false,
              "properties": {
                "unsubscribe": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "validate": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            }
          },
          "required": [
            "endpoint",
            "operations",
            "contract"
          ],
          "type": "object"
        },
        "observability": {
          "additionalProperties": false,
          "properties": {
            "cost": {
              "additionalProperties": false,
              "properties": {
                "groupBy": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            "metrics": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "dimensions": {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "type": "object"
                  },
                  "namespace": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "region": {
                    "type": "string"
                  },
                  "resource": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "series": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "metric": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "name": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "stat": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "unit": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "name",
                        "metric",
                        "stat"
                      ],
                      "type": "object"
                    },
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "required": [
                  "resource",
                  "namespace",
                  "series"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "provides": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "receivesAppSecrets": {
          "type": "boolean"
        },
        "releaseClass": {
          "type": "string"
        },
        "releaseNote": {
          "type": "string"
        },
        "requires": {
          "items": {
            "description": "A requirement: a type id, or an object of its type, its name and many.",
            "oneOf": [
              {
                "$ref": "#/$defs/typeId"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "many": {
                    "type": "boolean"
                  },
                  "name": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "type": {
                    "$ref": "#/$defs/typeIds"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "type": "array"
        },
        "resources": {
          "items": {
            "description": "A resource the block creates: a type id, or an object of its type and its name.",
            "oneOf": [
              {
                "$ref": "#/$defs/typeId"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "type": {
                    "$ref": "#/$defs/typeIds"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "minItems": 1,
          "type": "array"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "version",
        "resources",
        "lifecycle"
      ],
      "type": "object"
    },
    "type": {
      "enum": [
        "block",
        "capability"
      ],
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "apiVersion",
    "type",
    "metadata",
    "spec"
  ],
  "title": "mitstack block manifest mitstack/v1beta",
  "type": "object"
}
