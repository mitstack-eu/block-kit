verdict: absent
The only real import sits in a _test.go file, which binds a test rather than what the block serves.
-- main.go --
package main

func main() {}
-- main_test.go --
package main

import (
	"testing"

	"github.com/mitstack-eu/operator-kit/handler"
)

func TestHandlerIsReachable(t *testing.T) { _ = handler.New }
